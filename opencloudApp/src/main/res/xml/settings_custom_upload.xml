<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:iconSpaceReserved="false"
        app:key="custom_upload_source_path"
        app:title="@string/prefs_custom_upload_source_path_title" />
    <ListPreference
        app:dialogTitle="@string/prefs_custom_upload_media_type"
        app:iconSpaceReserved="false"
        app:key="custom_upload_media_type"
        app:negativeButtonText=""
        app:title="@string/prefs_custom_upload_media_type"
        app:useSimpleSummaryProvider="true" />
    <ListPreference
        app:dialogTitle="@string/prefs_custom_upload_account"
        app:iconSpaceReserved="false"
        app:key="custom_upload_account_name"
        app:negativeButtonText=""
        app:title="@string/prefs_custom_upload_account"
        app:useSimpleSummaryProvider="true" />
    <Preference
        app:iconSpaceReserved="false"
        app:key="custom_upload_path"
        app:title="@string/prefs_custom_upload_path_title" />
    <ListPreference
        app:dialogTitle="@string/prefs_camera_upload_behaviour_dialog_title"
        app:iconSpaceReserved="false"
        app:key="custom_upload_behaviour"
        app:negativeButtonText=""
        app:title="@string/prefs_camera_upload_behaviour_title"
        app:useSimpleSummaryProvider="true" />
    <Preference
        app:iconSpaceReserved="false"
        app:key="custom_upload_last_sync"
        app:title="@string/prefs_camera_upload_last_sync_title" />
    <eu.opencloud.android.presentation.settings.LargePreferenceCategory
        android:title="@string/prefs_camera_picture_upload_conditions_title"
        app:iconSpaceReserved="false"
        app:summary="@string/prefs_camera_picture_upload_conditions_summary">
        <CheckBoxPreference
            app:iconSpaceReserved="false"
            app:key="custom_upload_on_wifi"
            app:title="@string/prefs_custom_upload_on_wifi" />
        <CheckBoxPreference
            app:iconSpaceReserved="false"
            app:key="custom_upload_on_charging"
            app:title="@string/prefs_custom_upload_on_charging" />
    </eu.opencloud.android.presentation.settings.LargePreferenceCategory>
    <Preference
        app:allowDividerAbove="true"
        app:iconSpaceReserved="false"
        app:key="custom_upload_sync_now"
        app:summary="@string/prefs_custom_uploads_sync_now_summary"
        app:title="@string/prefs_custom_uploads_sync_now" />
    <Preference
        app:iconSpaceReserved="false"
        app:key="custom_upload_existing"
        app:summary="@string/prefs_custom_upload_existing_summary"
        app:title="@string/prefs_custom_upload_existing" />
    <Preference
        app:iconSpaceReserved="false"
        app:key="custom_upload_remove"
        app:summary="@string/prefs_custom_upload_remove_summary"
        app:title="@string/prefs_custom_upload_remove" />
</PreferenceScreen>
